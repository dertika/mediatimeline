# Build: podman build -f deploy/Containerfile -t mediatimeline:latest .

FROM docker.io/library/node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci
COPY backend backend
COPY frontend frontend
RUN npm run build

FROM docker.io/library/node:22-alpine
ENV NODE_ENV=production \
    MEDIATIMELINE_CONFIG=/config/config.yaml \
    MEDIATIMELINE_DATA_DIR=/data
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci --omit=dev -w backend && npm cache clean --force
COPY --from=build /src/backend/dist backend/dist
COPY --from=build /src/frontend/build backend/public
RUN mkdir -p /data /config && chown node:node /data

USER node
EXPOSE 8080
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
CMD ["node", "--disable-warning=ExperimentalWarning", "backend/dist/index.js"]
