# Podman Quadlet unit.
# Rootless: copy to ~/.config/containers/systemd/, then
#   systemctl --user daemon-reload && systemctl --user start mediatimeline
# Rootful: /etc/containers/systemd/

[Unit]
Description=mediatimeline – public photo timelines from Immich
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/dertika/mediatimeline:latest
# Locally built image instead: Image=localhost/mediatimeline:latest
AutoUpdate=registry
ContainerName=mediatimeline
# Only reachable through nginx on the same host.
PublishPort=127.0.0.1:8080:8080
Volume=%h/.config/mediatimeline/config.yaml:/config/config.yaml:ro,Z
Volume=mediatimeline-data:/data:U,Z
# Optional: keep the Immich API key out of config.yaml
#   printf '%s' 'KEY' | podman secret create immich_api_key -
# Secret=immich_api_key,type=mount,target=/run/secrets/immich_api_key
# Environment=MEDIATIMELINE_IMMICH_API_KEY_FILE=/run/secrets/immich_api_key
# Optional: GeoPulse on the same host. Join its Podman network so that
# geopulse.url can use the container name (e.g. http://geopulse-backend:8080),
# and keep its API token in a secret as well.
# Network=geopulse.network
#   printf '%s' 'TOKEN' | podman secret create geopulse_api_key -
# Secret=geopulse_api_key,type=mount,target=/run/secrets/geopulse_api_key
# Environment=MEDIATIMELINE_GEOPULSE_API_KEY_FILE=/run/secrets/geopulse_api_key
HealthCmd=wget -qO- http://127.0.0.1:8080/healthz || exit 1
HealthInterval=30s

[Service]
Restart=always

[Install]
WantedBy=default.target
